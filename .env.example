# -----------------------------
# [DB] 데이터베이스 접속 정보
# -----------------------------
POSTGRES_USER=daypoo
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=daypoo_db
DB_HOST=localhost
# 로컬 고정 포트 (5432 는 Windows 네이티브 PostgreSQL 과 자주 겹친다)
DB_PORT=15432

# -----------------------------
# [Redis] 레디스 접속 정보
# -----------------------------
REDIS_HOST=localhost
# 로컬 고정 포트 (6379 는 다른 프로젝트의 Redis 와 자주 겹친다)
REDIS_PORT=16379

# -----------------------------
# [Security] 인증 및 토큰 설정
# -----------------------------
# 256비트 이상의 유효한 Base64 인코딩 키 필요
JWT_SECRET_KEY=YOUR_SECURE_BASE64_KEY_HERE
FRONTEND_URL=http://localhost:5173

# -----------------------------
# [Admin] 관리자 계정 설정
# -----------------------------
# 미설정 시 기동은 정상 진행되지만 관리자 계정이 생성되지 않는다
ADMIN_EMAIL=admin@daypoo.com
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
# 소셜 로그인 시 관리자 권한을 부여할 이메일 목록 (쉼표 구분)
ADMIN_EMAILS=

# -----------------------------
# [API] 외부 연동 정보
# -----------------------------
PUBLIC_DATA_API_KEY=YOUR_PUBLIC_DATA_API_KEY

# -----------------------------
# [OAuth2] 소셜 로그인 정보
# -----------------------------
KAKAO_CLIENT_ID=YOUR_KAKAO_CLIENT_ID
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# -----------------------------
# Gmail SMTP 설정 (비밀번호 찾기용)
# -----------------------------
MAIL_USERNAME=YOUR_GMAIL_ID@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# -----------------------------
# 프론트엔드 지도 SDK 로드용 (JavaScript 키 입력)
# -----------------------------
VITE_KAKAO_MAP_KEY=YOUR_KAKAO_MAP_KEY
